Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-non-private-member-variables-in-classes,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-virtual-class-destructor,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -performance-no-int-to-ptr,

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: none

CheckOptions:
  # Allow main-like entry-point names.
  readability-identifier-naming.IgnoreMainLikeFunctions: true

  # Types: TraceController, VariableTrace
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase

  # Functions and methods: addVariable, checkForUpdates
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.ConstexprFunctionCase: camelBack
  readability-identifier-naming.ConstexprMethodCase: camelBack

  # Variables and parameters: trace, name, length
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.GlobalVariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ParameterPackCase: camelBack

  # Public and protected members: name, typeSize
  readability-identifier-naming.PublicMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberCase: camelBack

  # Private members: _amountOfTraces, _framedCommunication
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: '_'

  # Function-local constants: rawAngle, retryCount
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.LocalConstexprVariableCase: camelBack

  # Non-static const class members: configuredResolution
  readability-identifier-naming.ConstantMemberCase: camelBack

  # Static class constants: encoderCpr
  readability-identifier-naming.ClassConstantCase: camelBack
  readability-identifier-naming.ClassConstexprCase: camelBack

  # Namespace/file-scope constants: StatusMask, TwoPi
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstexprVariableCase: CamelCase

  # Enum values: Unknown, Running
  readability-identifier-naming.EnumConstantCase: CamelCase

  # Macros: INTEGRAL_MOTIONS_ASSERT
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

  # Namespaces: IntegralMotions::Tracing
  readability-identifier-naming.NamespaceCase: CamelCase